<!-- Core bundle: Bootstrap 5, styles and shared layout behaviour -->
<script type='module' src='/src/js/main.js'></script>

<!-- Page-specific modules, code-split by Vite and loaded on demand -->
<script type='module'>
  // Explicit route table. Each value uses a literal import specifier so Vite can
  // statically analyse it and emit one lazily-loaded chunk per page.
  const routes = {
    index: () => import('/src/js/pages/dashboard.js'),
    'charts-chartjs': () => import('/src/js/pages/charts.js').then(m => m.initializeCharts()),
    'forms-basic': () => import('/src/js/pages/forms.js').then(m => m.initializeFormsPage()),
    'forms-advanced': () => import('/src/js/pages/forms.js').then(m => m.initializeFormsPage()),
    'tables-basic': () => import('/src/js/pages/tables.js').then(m => m.initializeTablesPage()),
    'tables-data': () => import('/src/js/pages/tables-data.js'),
    'ui-sweetalert': () => import('/src/js/pages/ui-sweetalert.js'),
  };

  const file = window.location.pathname.split('/').pop() || 'index.html';
  const page = file.replace(/\.html$/, '') || 'index';

  // Pages with no entry simply have no page module — that is not an error.
  routes[page]?.().catch(error => {
    console.error(`Failed to load the "${page}" page module:`, error);
  });
</script>
